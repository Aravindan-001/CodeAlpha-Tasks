SOURCE CODE FOR RESPONSIVE CALCULATOR USING HTML,CSS,JS
HTML
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Simple Calculator</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <div class="calc-container">
    <div id="calc-display" class="calc-display">0</div>

    <div class="calc-buttons">
      <!-- row 1 -->
      <button data-action="clear">AC</button>
      <button data-action="delete">DEL</button>
      <button data-value="/">/</button>
      <button data-value="*">*</button>

      <!-- row 2 -->
      <button data-value="7">7</button>
      <button data-value="8">8</button>
      <button data-value="9">9</button>
      <button data-value="-">-</button>

      <!-- row 3 -->
      <button data-value="4">4</button>
      <button data-value="5">5</button>
      <button data-value="6">6</button>
      <button data-value="+">+</button>

      <!-- row 4 -->
      <button data-value="1">1</button>
      <button data-value="2">2</button>
      <button data-value="3">3</button>
      <button class="equals" data-action="calculate">=</button>

      <!-- row 5 -->
      <button data-value="0">0</button>
      <button data-value=".">.</button>
      <button data-value="(">(</button>
      <button data-value=")">)</button>
    </div>
  </div>

  <script src="index.js"></script>
</body>
</html>

CSS

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: "Segoe UI", sans-serif;
}

body {
  background: #ececec;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
}

.calc-container {
  background: #fff;
  width: 300px;
  border-radius: 15px;
  overflow: hidden;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
}

.calc-display {
  background: #111;
  color: #0ef;              /* bright cyan like in your shot */
  padding: 20px;
  font-size: 28px;
  text-align: right;
  min-height: 60px;
  overflow-x: auto;
}

.calc-buttons {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1px;
  background: #ccc;         /* creates thin grid lines */
}

button {
  background: #f7f7f7;
  border: none;
  padding: 20px;
  font-size: 18px;
  cursor: pointer;
  transition: background 0.2s ease;
}

button:hover {
  background: #eeeeee;
}

.equals {
  background: #06d6a0;
  color: #fff;
}

.equals:hover {
  background: #05c293;
}

JS
let res = document.getElementById("res");

function add(v){
  res.innerText = res.innerText==="0" ? v : res.innerText+v;
}

function equal(){
  res.innerText = eval(res.innerText);
}

function clr(){
  res.innerText = "0";
}




